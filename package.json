{
  "name": "formations-lab",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "data": "python3 scripts/data/parse_formations.py && python3 scripts/data/extract.py && python3 scripts/data/build_data.py",
    "dev": "vite dev --port 3000",
    "fix": "biome check --write .",
    "lint": "biome ci .",
    "prepare": "node scripts/install-git-hooks.mjs",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.2.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "motion": "^12.23.0",
    "nitro": "3.0.261103-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "ultracite": "8.1.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
